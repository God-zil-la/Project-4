{% load static %}
<aside class="app-sidebar" aria-label="Assistant navigation">
  <nav class="app-sidebar-nav" id="app-sidebar-links" aria-label="Main menu">
    <h2 class="app-sidebar-title"><button type="button" class="app-sidebar-toggle" aria-expanded="false" aria-controls="app-sidebar-links">☰ Main Menu</button></h2>

    <a href="/dashboard/">Dashboard</a>

    <a href="/bots/create/" class="sidebar-create-assistant">+ Create Assistant</a>

    <details class="app-sidebar-group sidebar-assistants-section"><summary>My AI Assistants</summary>
      <div class="app-sidebar-submenu">


        {% for bot in sidebar_bots %}
          <details class="app-sidebar-group sidebar-assistant-item"
                   data-sidebar-bot="{{ bot.id }}">
            <summary class="sidebar-assistant-heading">
              <span class="sidebar-assistant-identity">
                <span class="sidebar-assistant-avatar" aria-hidden="true">{{ bot.avatar_symbol|default:"🤖" }}</span>
                <span class="sidebar-assistant-name">{{ bot.name }}</span>
              </span>
              <span class="sidebar-assistant-chevron" aria-hidden="true">⌄</span>
            </summary>
            <div class="app-sidebar-submenu sidebar-chat-list"
                 data-sidebar-conversations="{{ bot.id }}">
              <a href="{% url 'bots:edit' bot.id %}"
                 class="sidebar-edit-assistant">
                ✏ Edit Assistant
              </a>
              <button type="button"
                      class="sidebar-new-chat"
                      data-sidebar-new-chat="{{ bot.id }}">
                + Create New Chat
              </button>
              <div class="sidebar-chat-items"
                   data-sidebar-chat-items="{{ bot.id }}">
                <span class="sidebar-chat-status">Loading chats...</span>
              </div>
            </div>
          </details>
        {% empty %}
          <span>No assistants yet</span>
        {% endfor %}
      </div>
    </details>

    <a href="{% url 'bots:analytics' %}">Analytics</a>
    <a href="/payments/">Billing</a>

    <a href="{% url 'accounts:api-access' %}">API Access</a>
    <a href="{% static 'pdf/ai_assistant_setup_guide_v2.pdf' %}"
       target="_blank" rel="noopener noreferrer">
      Download Complete User Guide (PDF)
    </a>

    <div class="sidebar-theme-control">
      <button id="toggleTheme"
              class="toggle-theme"
              type="button"
              aria-label="Toggle light and dark theme"
              title="Toggle light and dark theme">
        <span id="theme-icon" aria-hidden="true">🌙</span>
        <span>Appearance</span>
      </button>
    </div>

    <form id="sidebar-logout-form"
          method="POST"
          action="{% url 'accounts:logout' %}">
      {% csrf_token %}
      <button type="submit" class="sidebar-logout-button">
        Logout
      </button>
    </form>
  </nav>
</aside>


<style>
/* sidebar-assistant-tree-v2 */
.app-sidebar .sidebar-assistant-item {
  margin: 3px 0;
  min-width: 0;
}

.app-sidebar .sidebar-assistant-heading {
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  min-height: 38px;
  padding: 7px 10px;
  border-radius: 8px;
  list-style: none;
}

.app-sidebar .sidebar-assistant-heading::-webkit-details-marker {
  display: none;
}

.app-sidebar .sidebar-assistant-identity {
  display: flex;
  align-items: center;
  gap: 9px;
  min-width: 0;
  flex: 1;
}

.app-sidebar .sidebar-assistant-avatar {
  flex: 0 0 24px;
  text-align: center;
  font-size: 18px;
  line-height: 1.3;
}

.app-sidebar .sidebar-assistant-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 13px;
}

.app-sidebar .sidebar-assistant-chevron {
  flex: 0 0 auto;
  transition: transform .15s ease;
}

.app-sidebar .sidebar-assistant-item[open]
.sidebar-assistant-chevron {
  transform: rotate(180deg);
}

.app-sidebar .sidebar-chat-list {
  display: block;
  padding: 4px 0 6px 12px;
  margin: 0;
  min-width: 0;
}

.app-sidebar .sidebar-assistant-item:not([open])
.sidebar-chat-list {
  display: none;
}

.app-sidebar .sidebar-new-chat,
.app-sidebar .sidebar-chat-retry {
  display: block;
  width: 100%;
  padding: 8px 9px;
  margin: 2px 0;
  text-align: left;
  font-size: 12px;
  border-radius: 7px;
  cursor: pointer;
  color: inherit;
  background: transparent;
  border: 1px solid currentColor;
}

.app-sidebar .sidebar-chat-items {
  max-height: 280px;
  overflow-y: auto;
  min-width: 0;
}

.app-sidebar .sidebar-chat-items
.app-sidebar-conversation {
  display: block;
  padding: 7px 9px;
  margin: 2px 0;
  border-radius: 6px;
  font-size: 12px;
  text-align: left;
  text-decoration: none;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.app-sidebar .sidebar-chat-status {
  display: block;
  padding: 8px 9px;
  font-size: 12px;
  opacity: .75;
}

.app-sidebar .sidebar-chat-items
.app-sidebar-conversation:hover,
.app-sidebar .sidebar-assistant-heading:hover {
  background: rgba(128,128,128,.12);
}

.app-sidebar .sidebar-new-chat:disabled {
  opacity: .6;
  cursor: wait;
}
</style>

<script>
/* sidebar-assistant-tree-v2 */
document.addEventListener("DOMContentLoaded", () => {
  const groups = document.querySelectorAll(
    ".sidebar-assistant-item[data-sidebar-bot]"
  );

  if (!groups.length) return;

  const apiUrl = "{% url 'bots:conversation-list-create' %}";
  const playgroundBase = "/bots/";
  let conversationCache = null;
  let pendingRequest = null;

  function getCsrfToken() {
    const input = document.querySelector(
      '#sidebar-logout-form input[name="csrfmiddlewaretoken"]'
    );
    if (input && input.value) return input.value;

    const match = document.cookie.match(
      /(?:^|;\s*)csrftoken=([^;]+)/
    );
    return match ? decodeURIComponent(match[1]) : "";
  }

  function chatUrl(botId, conversationId) {
    return playgroundBase
      + encodeURIComponent(botId)
      + "/playground/?conversation="
      + encodeURIComponent(conversationId);
  }

  async function getConversations(forceRefresh = false) {
    if (!forceRefresh && conversationCache !== null) {
      return conversationCache;
    }

    if (!forceRefresh && pendingRequest) {
      return pendingRequest;
    }

    const request = (async () => {
      const response = await fetch(apiUrl, {
        credentials: "same-origin",
        headers: { "Accept": "application/json" }
      });

      if (!response.ok) {
        throw new Error("HTTP " + response.status);
      }

      const data = await response.json();

      if (!Array.isArray(data)) {
        throw new Error("Unexpected conversation response.");
      }

      conversationCache = data;
      return data;
    })();

    pendingRequest = request;

    try {
      return await request;
    } finally {
      if (pendingRequest === request) {
        pendingRequest = null;
      }
    }
  }

  function showStatus(container, message) {
    container.replaceChildren();
    const status = document.createElement("span");
    status.className = "sidebar-chat-status";
    status.textContent = message;
    container.appendChild(status);
  }

  async function renderChats(group) {
    const botId = group.dataset.sidebarBot;
    const container = group.querySelector(
      "[data-sidebar-chat-items]"
    );

    if (!container) return;

    showStatus(container, "Loading chats...");

    try {
      const conversations = await getConversations();
      if (!group.open) return;

      const chats = conversations.filter(
        item => String(item.bot_id) === String(botId)
      );

      container.replaceChildren();

      if (!chats.length) {
        showStatus(container, "No chats yet");
        return;
      }

      for (const chat of chats) {
        if (!chat.conversation_id) continue;

        const link = document.createElement("a");
        link.className = "app-sidebar-conversation";
        link.href = chatUrl(botId, chat.conversation_id);
        link.textContent = chat.title || "New Chat";
        link.title = link.textContent;
        container.appendChild(link);
      }

      if (!container.children.length) {
        showStatus(container, "No chats yet");
      }
    } catch (error) {
      console.error("Sidebar conversations:", error);
      showStatus(container, "Could not load chats");

      const retry = document.createElement("button");
      retry.type = "button";
      retry.className = "sidebar-chat-retry";
      retry.textContent = "Retry";

      retry.addEventListener("click", async () => {
        conversationCache = null;
        await renderChats(group);
      });

      container.appendChild(retry);
    }
  }

  groups.forEach(group => {
    group.addEventListener("toggle", () => {
      if (group.open) renderChats(group);
    });

    const newChat = group.querySelector(
      "[data-sidebar-new-chat]"
    );

    if (!newChat) return;

    newChat.addEventListener("click", async () => {
      if (newChat.disabled) return;

      const botId = group.dataset.sidebarBot;
      newChat.disabled = true;
      newChat.textContent = "Creating chat...";

      try {
        const csrfToken = getCsrfToken();

        if (!csrfToken) {
          throw new Error("Missing CSRF token.");
        }

        const response = await fetch(apiUrl, {
          method: "POST",
          credentials: "same-origin",
          headers: {
            "Accept": "application/json",
            "Content-Type": "application/json",
            "X-CSRFToken": csrfToken
          },
          body: JSON.stringify({
            bot_id: Number(botId),
            title: ""
          })
        });

        if (!response.ok) {
          throw new Error("HTTP " + response.status);
        }

        const conversation = await response.json();

        if (!conversation.conversation_id) {
          throw new Error("Missing conversation ID.");
        }

        conversationCache = null;
        window.location.assign(
          chatUrl(botId, conversation.conversation_id)
        );
      } catch (error) {
        console.error("Create New Chat:", error);
        newChat.textContent = "Could not create chat - Retry";
        newChat.disabled = false;
      }
    });
  });
});
</script>

<script>document.addEventListener('DOMContentLoaded', () => { const sidebar = document.querySelector('.app-sidebar'); const button = sidebar?.querySelector('.app-sidebar-toggle'); if (!sidebar || !button) return; const mobile = window.matchMedia('(max-width: 1023px)'); const sync = () => { sidebar.classList.toggle('is-collapsed', mobile.matches); button.setAttribute('aria-expanded', String(!mobile.matches)); }; sync(); mobile.addEventListener('change', sync); button.addEventListener('click', () => { if (!mobile.matches) return; const collapsed = sidebar.classList.toggle('is-collapsed'); button.setAttribute('aria-expanded', String(!collapsed)); }); });</script>

<!-- ASSISTANT_EDIT_EXTRAS_PERMANENT_V1 -->
<style>
  .assistant-edit-extra-stack {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .assistant-edit-extra-card {
    background: rgba(20,43,80,.65);
    border: 1px solid #367a98;
    border-radius: 14px;
    padding: 16px;
    color: #f5f7ff;
    box-sizing: border-box;
    min-width: 0;
  }

  .assistant-edit-extra-card h3 {
    margin: 0 0 12px;
    color: #28a3c4;
    font-size: 17px;
  }

  .assistant-edit-extra-card p {
    color: #b9c4d8;
    font-size: 13px;
    line-height: 1.6;
  }

  .assistant-edit-extra-identity {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 14px 0;
  }

  .assistant-edit-extra-identity > span {
    font-size: 26px;
  }

  .assistant-edit-extra-identity small {
    display: block;
    color: #b9c4d8;
    margin-top: 4px;
  }

  .assistant-edit-extra-check {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 0;
    border-bottom: 1px solid rgba(150,180,220,.15);
    font-size: 13px;
  }

  .assistant-edit-extra-message {
    padding: 12px;
    border-radius: 12px;
    font-size: 13px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .assistant-edit-extra-message.user {
    margin-left: 12%;
    background: rgba(35,120,205,.25);
    text-align: right;
  }

  .assistant-edit-extra-message.assistant {
    margin-right: 12%;
    background: rgba(100,125,160,.18);
  }

  .assistant-edit-extra-example {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid rgba(150,180,220,.16);
  }

  .assistant-edit-extra-example strong {
    font-size: 14px;
  }

  .assistant-edit-extra-example button {
    flex-shrink: 0;
    padding: 8px 12px;
    border: 1px solid #367a98;
    border-radius: 8px;
    background: #17294c;
    color: white;
    cursor: pointer;
  }

  .assistant-edit-extra-example button:hover {
    background: #244474;
  }

  #assistant-edit-middle-extras {
    margin-top: 24px;
  }

  @media (min-width: 1024px) {
    body:has(.assistant-edit-form, .assistant-create-form)
> #assistant-edit-sidebar-extras {
  grid-column: 1;
  grid-row: 3;
  align-self: start;
  min-width: 0;
  margin-left: 5px;
  margin-right: 5px;
}
  }

  @media (max-width: 1023px) {
    #assistant-edit-sidebar-extras {
      margin-top: 20px;
    }
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const form = document.querySelector(".assistant-edit-form, .assistant-create-form");
  const sidebar = document.querySelector("body > .app-sidebar");

  if (!form || !sidebar) return;

  const leftPanel = [...form.querySelectorAll(".assistant-form-panel")]
    .find(el => !el.classList.contains("assistant-customization-panel"));

  if (!leftPanel) return;

  if (document.getElementById("assistant-edit-sidebar-extras")) return;

  const sidebarExtras = document.createElement("div");
  sidebarExtras.id = "assistant-edit-sidebar-extras";
  sidebarExtras.className = "assistant-edit-extra-stack";

  sidebarExtras.innerHTML = `
    <section class="assistant-edit-extra-card">
      <h3>&#128065; Assistant Preview</h3>
      <p>See how your assistant is presented.</p>
      <div class="assistant-edit-extra-identity">
        <span aria-hidden="true">&#129302;</span>
        <div>
          <strong data-edit-preview-name>Assistant</strong>
          <small data-edit-preview-category>General</small>
        </div>
      </div>
      <p data-edit-preview-description></p>
    </section>

    <section class="assistant-edit-extra-card">
      <h3>&#10003; Setup Checklist</h3>
      <div data-edit-checklist></div>
    </section>

    <section class="assistant-edit-extra-card">
      <h3>&#128172; Example Conversation</h3>
      <p>Preview how a conversation might look.</p>
      <div class="assistant-edit-extra-message user">
        Hi! What can you help me with?
      </div>
      <div class="assistant-edit-extra-message assistant"
           style="margin-top:12px">
        I'm your personal AI assistant. How can I help you today?
      </div>
      <p><small>Example only. No AI request is sent.</small></p>
    </section>
  `;

  const middleExtras = document.createElement("div");
  middleExtras.id = "assistant-edit-middle-extras";
  middleExtras.className = "assistant-edit-extra-stack";

  middleExtras.innerHTML = `
    <section class="assistant-edit-extra-card">
      <h3>&#128161; Tips for Better Assistants</h3>
      <p>Give your assistant a clear role and purpose.</p>
      <p>Describe how it should respond and provide examples.</p>
      <p>Use specific instructions for more consistent results.</p>
    </section>

    <section class="assistant-edit-extra-card">
      <h3>&#128203; Instruction Examples</h3>
      <p>Copy an example to help customize your assistant.</p>
      <div data-edit-instruction-examples></div>
    </section>
  `;

  leftPanel.appendChild(middleExtras);

  const examples = [
    ["Professional", "Respond professionally, clearly, and concisely."],
    ["Friendly", "Use a warm, approachable tone and simple language."],
    ["Educational", "Explain concepts step by step with practical examples."]
  ];

  const exampleList = middleExtras.querySelector(
    "[data-edit-instruction-examples]"
  );

  examples.forEach(([title, value]) => {
    const row = document.createElement("div");
    row.className = "assistant-edit-extra-example";

    const content = document.createElement("div");
    const heading = document.createElement("strong");
    heading.textContent = title;

    const description = document.createElement("p");
    description.textContent = value;
    content.append(heading, description);

    const button = document.createElement("button");
    button.type = "button";
    button.textContent = "Copy";
    button.setAttribute("aria-label", "Copy " + title + " instructions");

    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(value);
        button.textContent = "Copied!";
      } catch {
        button.textContent = "Copy failed";
      }
    });

    row.append(content, button);
    exampleList.appendChild(row);
  });

  const fields = [...form.querySelectorAll("input,select,textarea")];

  function findField(pattern) {
    return fields.find(el =>
      pattern.test([el.name, el.id].filter(Boolean).join(" "))
    );
  }

  const nameField = findField(/name/i);
  const categoryField = findField(/category/i);
  const descriptionField = findField(/description/i);
  const personalityField = findField(/personality|instruction/i);

  function updatePreview() {
    const name = nameField?.value.trim() || "Unnamed Assistant";
    const category = categoryField?.selectedOptions?.[0]?.text ||
      categoryField?.value || "General";
    const description = descriptionField?.value.trim() || "";

    sidebarExtras.querySelector("[data-edit-preview-name]").textContent =
      name;

    sidebarExtras.querySelector("[data-edit-preview-category]").textContent =
      category;

    sidebarExtras.querySelector("[data-edit-preview-description]").textContent =
      description || "Add a description to introduce your assistant.";

    const checklist = sidebarExtras.querySelector("[data-edit-checklist]");
    checklist.replaceChildren();

    [
      ["Assistant name", !!nameField?.value.trim()],
      ["Description", !!description],
      ["Personality & instructions", !!personalityField?.value.trim()]
    ].forEach(([label, complete]) => {
      const row = document.createElement("div");
      row.className = "assistant-edit-extra-check";

      const text = document.createElement("span");
      text.textContent = label;

      const status = document.createElement("span");
      status.textContent = complete ? "\u2713 Complete" : "\u25CB Missing";
      status.style.color = complete ? "#63d9a0" : "#b9c4d8";

      row.append(text, status);
      checklist.appendChild(row);
    });
  }

  fields.forEach(el => {
    el.addEventListener("input", updatePreview);
    el.addEventListener("change", updatePreview);
  });

  function placeExtras() {
    if (window.innerWidth < 1024) {
      if (sidebarExtras.parentElement !== leftPanel) {
        middleExtras.insertAdjacentElement("afterend", sidebarExtras);
      }
      sidebarExtras.style.marginTop = "0";
      return;
    }

    if (sidebarExtras.parentElement !== document.body) {
      sidebar.insertAdjacentElement("afterend", sidebarExtras);
    }

    sidebarExtras.style.marginTop = "0";

    const sidebarBottom =
      sidebar.getBoundingClientRect().bottom + window.scrollY;

    const extrasTop =
      sidebarExtras.getBoundingClientRect().top + window.scrollY;

    sidebarExtras.style.marginTop =
      Math.max(0, sidebarBottom - extrasTop + 16) + "px";
  }

  updatePreview();
  placeExtras();

  window.addEventListener("resize", placeExtras);

  if (window.ResizeObserver) {
    const observer = new ResizeObserver(placeExtras);
    observer.observe(sidebar);
  }
});
</script>

<!-- ASSISTANT_CARDS_LIGHT_MODE_V1 -->
<style>
/* Light Mode only. Existing Dark Mode stays unchanged. */
html[data-theme="light"] .assistant-edit-extra-card,
body[data-theme="light"] .assistant-edit-extra-card,
html.light .assistant-edit-extra-card,
body.light .assistant-edit-extra-card,
html:not([data-theme]):not(.dark) .assistant-edit-extra-card {
    background: #ffffff !important;
    border-color: #cbd5e1 !important;
    color: #17243b !important;
    box-shadow: 0 3px 12px rgba(25, 50, 80, .07);
}

html[data-theme="light"] .assistant-edit-extra-card h3,
body[data-theme="light"] .assistant-edit-extra-card h3,
html.light .assistant-edit-extra-card h3,
body.light .assistant-edit-extra-card h3,
html:not([data-theme]):not(.dark) .assistant-edit-extra-card h3 {
    color: #087fa5 !important;
}

html[data-theme="light"] .assistant-edit-extra-card p,
body[data-theme="light"] .assistant-edit-extra-card p,
html.light .assistant-edit-extra-card p,
body.light .assistant-edit-extra-card p,
html:not([data-theme]):not(.dark) .assistant-edit-extra-card p {
    color: #475569 !important;
}

html[data-theme="light"] .assistant-edit-extra-card small,
body[data-theme="light"] .assistant-edit-extra-card small,
html.light .assistant-edit-extra-card small,
body.light .assistant-edit-extra-card small,
html:not([data-theme]):not(.dark) .assistant-edit-extra-card small {
    color: #64748b !important;
}

html[data-theme="light"] .assistant-edit-extra-card strong,
body[data-theme="light"] .assistant-edit-extra-card strong,
html.light .assistant-edit-extra-card strong,
body.light .assistant-edit-extra-card strong,
html:not([data-theme]):not(.dark) .assistant-edit-extra-card strong {
    color: #17243b !important;
}

html[data-theme="light"] .assistant-edit-extra-check,
body[data-theme="light"] .assistant-edit-extra-check,
html.light .assistant-edit-extra-check,
body.light .assistant-edit-extra-check,
html:not([data-theme]):not(.dark) .assistant-edit-extra-check {
    border-bottom-color: #e2e8f0 !important;
    color: #334155 !important;
}

html[data-theme="light"] .assistant-edit-extra-message.user,
body[data-theme="light"] .assistant-edit-extra-message.user,
html.light .assistant-edit-extra-message.user,
body.light .assistant-edit-extra-message.user,
html:not([data-theme]):not(.dark) .assistant-edit-extra-message.user {
    background: #dbeafe !important;
    color: #1e3a8a !important;
}

html[data-theme="light"] .assistant-edit-extra-message.assistant,
body[data-theme="light"] .assistant-edit-extra-message.assistant,
html.light .assistant-edit-extra-message.assistant,
body.light .assistant-edit-extra-message.assistant,
html:not([data-theme]):not(.dark) .assistant-edit-extra-message.assistant {
    background: #f1f5f9 !important;
    color: #334155 !important;
}

html[data-theme="light"] .assistant-edit-extra-example,
body[data-theme="light"] .assistant-edit-extra-example,
html.light .assistant-edit-extra-example,
body.light .assistant-edit-extra-example,
html:not([data-theme]):not(.dark) .assistant-edit-extra-example {
    border-bottom-color: #e2e8f0 !important;
}

html[data-theme="light"] .assistant-edit-extra-example button,
body[data-theme="light"] .assistant-edit-extra-example button,
html.light .assistant-edit-extra-example button,
body.light .assistant-edit-extra-example button,
html:not([data-theme]):not(.dark) .assistant-edit-extra-example button {
    background: #e8f3ff !important;
    border-color: #93b8e3 !important;
    color: #174a83 !important;
}

html[data-theme="light"] .assistant-edit-extra-example button:hover,
body[data-theme="light"] .assistant-edit-extra-example button:hover,
html.light .assistant-edit-extra-example button:hover,
body.light .assistant-edit-extra-example button:hover,
html:not([data-theme]):not(.dark) .assistant-edit-extra-example button:hover {
