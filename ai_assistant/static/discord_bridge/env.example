# Example .env file for Discord Bridge
# ----------------------------------------
# Fill in these values with your details
# ----------------------------------------

# Your Discord bot token (from Discord Developer Portal → Bot → Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Separate Discord integration credential from the downloaded configuration.
# Keep this secret; do not use your normal account token.
DJANGO_API_TOKEN=your_discord_integration_secret

# Your Bot ID (from our web dashboard)
DJANGO_BOT_ID=your_bot_id_from_web_dashboard

# HTTPS backend origin; the download uses the deployment's DEFAULT_DOMAIN.
# This example does not override the deployment configuration.
DJANGO_BACKEND=https://www.myaiassistantapp.se

# Enable Message Content Intent in Discord Developer Portal -> Bot.
# Grant View Channels, Send Messages, and Send Messages in Threads when needed.
# Use !ask <question>, @bot <question>, or send a DM. !ping checks connectivity.
# Conversations are separate per channel/thread/DM and restart with the bridge.
# Keep .env and the downloaded ZIP private. See bridge.py for setup details.
